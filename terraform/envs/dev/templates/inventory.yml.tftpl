# Generated by Terraform - do not edit by hand. Contains no secrets.
all:
  vars:
    aws_region: ${aws_region}
    ssh_private_key_path: ${private_key_path}
  children:
%{ if enable_linux ~}
    linux:
      hosts:
        nginx-linux:
          ansible_host: ${linux_ip}
          ansible_user: ec2-user
          ansible_ssh_private_key_file: "{{ ssh_private_key_path }}"
          nginx_server_names: ["${linux_dns}", "${linux_ip}"]
%{ endif ~}
%{ if enable_windows ~}
    windows:
      hosts:
        nginx-windows:
          ansible_host: ${windows_ip}
          ec2_instance_id: ${windows_instance_id}
          nginx_server_names: ["${windows_dns}", "${windows_ip}"]
      vars:
        # ansible_password is fetched + decrypted at run time (see site.yml)
        ansible_user: Administrator
        ansible_connection: winrm
        ansible_port: 5986
        ansible_winrm_transport: ntlm
        ansible_winrm_server_cert_validation: ignore
%{ endif ~}
